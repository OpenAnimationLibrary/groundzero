{
  "name": "groundzero-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "packageManager": "pnpm@12.21.0",
  "imports": {
    "#mcp/*": { "types": "./src/*.ts", "default": "./dist/*.js" }
  },
  "bin": { "groundzero-mcp": "./dist/cli.js" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src vitest.config.ts",
    "format:check": "oxfmt --check src vitest.config.ts *.json",
    "test": "vitest run --exclude src/native.test.ts",
    "test:native": "vitest run src/native.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "22.20.5",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
