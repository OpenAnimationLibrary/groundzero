{
 "schema_version": 1,
 "operations": [
  "inspect",
  "create",
  "modify",
  "duplicate",
  "reorder",
  "remove",
  "persist",
  "recover"
 ],
 "definitions": {
  "inspect": "read it back",
  "create": "make a new one",
  "modify": "change one in place",
  "duplicate": "make an independent copy",
  "reorder": "change its position among its peers",
  "remove": "delete it",
  "persist": "it is written to a saved package",
  "recover": "it returns after a loss: reopen the package, or undo"
 },
 "families": [
  {
   "id": "document",
   "name": "Draft scene document",
   "cells": {
    "inspect": {
     "tools": [
      "scene.summary",
      "automation.list_documents",
      "scene.validate",
      "scene.dependencies"
     ]
    },
    "create": {
     "tools": [
      "scene.create",
      "scene.open",
      "scene.open_read_only"
     ]
    },
    "modify": {
     "tools": [
      "scene.settings",
      "scene.output.set",
      "scene.guides.set"
     ]
    },
    "duplicate": {
     "tools": [
      "scene.save_copy",
      "scene.open"
     ],
     "evidence": "mcp_w2_cases.py"
    },
    "reorder": {
     "disposition": "unsupported",
     "reason": "documents are unordered; the worker lists them by handle"
    },
    "remove": {
     "tools": [
      "scene.discard"
     ]
    },
    "persist": {
     "tools": [
      "scene.save_copy"
     ],
     "evidence": "mcp_w2_cases.py"
    },
    "recover": {
     "disposition": "no_undo",
     "reason": "a draft scene has no undo history; recover by reopening a saved package or by editing back"
    }
   }
  },
  {
   "id": "package",
   "name": "Saved scene package",
   "cells": {
    "inspect": {
     "tools": [
      "scene.package_info"
     ]
    },
    "create": {
     "tools": [
      "scene.save_copy"
     ]
    },
    "modify": {
     "disposition": "unsupported",
     "reason": "a package is immutable once published; save a new one"
    },
    "duplicate": {
     "tools": [
      "scene.save_copy"
     ]
    },
    "reorder": {
     "disposition": "unsupported",
     "reason": "a package has no order"
    },
    "remove": {
     "disposition": "restricted",
     "reason": "no tool deletes a published package: publication never replaces and cleanup of files is an operator task"
    },
    "persist": {
     "tools": [
      "scene.save_copy"
     ],
     "evidence": "mcp_acceptance.py"
    },
    "recover": {
     "tools": [
      "scene.open"
     ],
     "evidence": "mcp_w2_cases.py"
    }
   }
  },
  {
   "id": "project",
   "name": "Project",
   "cells": {
    "inspect": {
     "tools": [
      "project.inspect",
      "project.list",
      "project.scenes"
     ]
    },
    "create": {
     "disposition": "planned",
     "outcome": "project.create_and_select"
    },
    "modify": {
     "disposition": "planned",
     "outcome": "project.create_and_select"
    },
    "duplicate": {
     "disposition": "planned",
     "outcome": "project.portable_collection"
    },
    "reorder": {
     "disposition": "unsupported",
     "reason": "projects have no order"
    },
    "remove": {
     "disposition": "restricted",
     "reason": "projects are user folders; no tool deletes one"
    },
    "persist": {
     "disposition": "planned",
     "outcome": "project.create_and_select"
    },
    "recover": {
     "disposition": "planned",
     "outcome": "scene.recover_autosave"
    }
   }
  },
