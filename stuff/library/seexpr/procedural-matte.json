{
  "format": "groundzero-seexpr",
  "version": 1,
  "title": "Procedural Matte",
  "document": {
    "version": 1,
    "backend": "interpreter",
    "rgb": "[1,1,1]",
    "alpha": "smoothstep(noise([$u*$scale,$v*$scale,$seed]),0.35,0.65)",
    "controls": [
      {
        "id": "scale",
        "name": "scale",
        "label": "Scale",
        "type": "scalar",
        "value": 8,
        "min": 0.01,
        "max": 64
      }
    ]
  }
}
