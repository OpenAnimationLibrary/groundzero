{
  "format": "groundzero-seexpr",
  "version": 1,
  "title": "Animated Stripes",
  "document": {
    "version": 1,
    "backend": "interpreter",
    "rgb": "mix($dark,$light,0.5+0.5*sin(($u*$frequency+$time*$speed)*6.283185307179586))",
    "alpha": "1",
    "controls": [
      {
        "id": "frequency",
        "name": "frequency",
        "label": "Frequency",
        "type": "scalar",
        "value": 8,
        "min": 0.01,
        "max": 64
      },
      {
        "id": "speed",
        "name": "speed",
        "label": "Speed",
        "type": "scalar",
        "value": 0.25,
        "min": -5,
        "max": 5
      },
      {
        "id": "light",
        "name": "light",
        "type": "color",
        "value": [
          0.8,
          0.4,
          0.1
        ]
      },
      {
        "id": "dark",
        "name": "dark",
        "type": "color",
        "value": [
          0.05,
          0.1,
          0.2
        ]
      }
    ]
  }
}
