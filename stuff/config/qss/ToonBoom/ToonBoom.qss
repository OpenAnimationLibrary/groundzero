  qproperty-XsheetCamstandButtonOffImage: url('../Default/imgs/white/xsheet/x_table_view_off.svg');
  qproperty-XsheetLockButtonBgOnColor: #d9534f;
  qproperty-XsheetLockButtonOnImage: url('../Default/imgs/white/xsheet/x_lock_on.svg');
  qproperty-XsheetLockButtonBgOffColor: transparent;
  qproperty-XsheetLockButtonOffImage: url('../Default/imgs/white/xsheet/x_lock_off.svg');
  qproperty-XsheetConfigButtonBgColor: transparent;
  qproperty-XsheetConfigButtonImage: url('../Default/imgs/white/xsheet/x_config.svg');
  qproperty-TimelineIconLineColor: #24262a;
  qproperty-FrameRangeMarkerLineColor: rgba(255, 255, 255, 0.5);
  qproperty-TimelinePreviewButtonBgOnColor: #dcc85a;
  qproperty-TimelinePreviewButtonOnImage: url('../Default/imgs/white/timeline/preview_small.svg');
  qproperty-TimelinePreviewButtonBgOffColor: #3b3e42;
  qproperty-TimelinePreviewButtonOffImage: url('../Default/imgs/white/timeline/transparent.svg');
  qproperty-TimelineUnifiedButtonTranspImage: url('../Default/imgs/white/timeline/preview_trans_small.svg');
  qproperty-TimelineCamstandButtonBgOnColor: #e6a273;
  qproperty-TimelineCamstandButtonOnImage: url('../Default/imgs/white/timeline/table_small.svg');
  qproperty-TimelineCamstandButtonTranspImage: url('../Default/imgs/white/timeline/trans_small.svg');
  qproperty-TimelineCamstandButtonBgOffColor: #3b3e42;
  qproperty-TimelineCamstandButtonOffImage: url('../Default/imgs/white/timeline/transparent.svg');
  qproperty-TimelineLockButtonBgOnColor: #d9534f;
  qproperty-TimelineLockButtonOnImage: url('../Default/imgs/white/timeline/lock_on_small.svg');
  qproperty-TimelineLockButtonBgOffColor: #3b3e42;
  qproperty-TimelineLockButtonOffImage: url('../Default/imgs/white/timeline/transparent.svg');
  qproperty-TimelineConfigButtonBgColor: #3b3e42;
  qproperty-TimelineConfigButtonImage: url('../Default/imgs/white/timeline/timeline_config.svg');
}
XsheetViewer QListWidget {
  background-color: #2f3236;
  border: 1 solid #4a4e54;
}
XsheetViewer QListWidget::item {
  color: #d6d9dc;
  padding: 3 0 3 0;
}
XsheetViewer QListWidget::item:hover {
  background-color: #44494f;
  color: white;
}
XsheetViewer QListWidget::item:selected {
  background-color: #3296a8;
  color: white;
}
/* -----------------------------------------------------------------------------
   Function Editor
----------------------------------------------------------------------------- */
#FunctionEditor QToolBar {
  border: 0;
  height: 26;
  min-height: 26;
  max-height: 26;
}
#FunctionEditor QToolBar QToolBar {
  border: 0;
}
#FunctionEditor QToolButton {
  margin: 0;
  padding: 2;
}
#FunctionParametersPanel {
  background-color: transparent;
  border-width: 1;
  border-style: solid;
  border-radius: 3px;
  border-color: #4a4e54;
}
#FunctionEditorTree {
  font-weight: normal;
  background-color: #2f3236;
  alternate-background-color: transparent;
  border: 0;
  margin: 0;
  outline: 0;
  border-top: 1 solid #24262a;
}
#FunctionEditorTree::item:selected {
  background-color: #3296a8;
  color: white;
}
#FunctionEditorTree::item:selected:hover {
  background-color: #41b2c7;
  color: white;
}
#FunctionEditorTree::item:hover {
  background-color: #44494f;
}
#FunctionEditorTree::branch {
  background-color: transparent;
}
#FunctionEditorTree::branch:adjoins-item {
  border-image: url('../Default/imgs/white/misc/transparent_16x16.png');
}
#FunctionEditorTree::branch:has-siblings {
  border-image: url('../Default/imgs/white/misc/transparent_16x16.png');
}
#FunctionEditorTree::branch:has-siblings:adjoins-item {
  border-image: url('../Default/imgs/white/misc/transparent_16x16.png');
}
#FunctionEditorTree::branch:has-children:closed {
  background: url('../Default/imgs/white/tree/treebranch-closed.svg') no-repeat;
  background-position: center center;
  border-image: none;
  image: none;
}
#FunctionEditorTree::branch:has-children:open {
  background: url('../Default/imgs/white/tree/treebranch-open.svg') no-repeat;
  background-position: center center;
  image: none;
}
#FunctionEditorTree::branch:has-children:has-siblings:closed {
  background: url('../Default/imgs/white/tree/treebranch-closed.svg') no-repeat;
  background-position: center center;
  border-image: none;
  image: none;
}
#FunctionEditorTree::branch:has-children:has-siblings:open {
  background: url('../Default/imgs/white/tree/treebranch-open.svg') no-repeat;
  background-position: center center;
  border-image: none;
  image: none;
}
FunctionTreeView {
  qproperty-TextColor: #d6d9dc;
}
/* Function Editor Spreadsheet
----------------------------------------------------------------------------- */
#ScrollRowArea,
#ScrollCellArea {
  border-top: 1 solid rgba(0, 0, 0, 0.5);
}
#ScrollCellArea {
  border-left: 1 solid rgba(0, 0, 0, 0.5);
}
#ScrollColumnArea {
  padding-left: 2;
}
FunctionPanel {
  font-weight: bold;
  qproperty-BGColor: #2f3236;
  qproperty-ValueLineColor: #232629;
  qproperty-FrameLineColor: #232629;
  qproperty-OtherCurvesColor: rgba(255, 255, 255, 0.6);
  qproperty-RulerBackground: #2a2c2f;
  qproperty-TextColor: #d6d9dc;
  qproperty-SubColor: black;
  qproperty-SelectedColor: #5fe3f0;
}
SpreadsheetViewer {
  qproperty-BGColor: #383b3f;
  qproperty-TextColor: white;
  qproperty-LightLightBGColor: #303336;
  qproperty-LightLineColor: rgba(0, 0, 0, 0.35);
  qproperty-VerticalLineColor: rgba(0, 0, 0, 0.5);
  qproperty-KeyframeLineColor: white;
  qproperty-FrameTextColor: #c8ccd0;
  qproperty-CurrentRowTextColor: white;
  qproperty-CurrentRowBgColor: rgba(50, 150, 168, 0.8);
  qproperty-MarkerLineColor: rgba(255, 255, 255, 0.15);
  qproperty-SecMarkerLineColor: rgba(255, 255, 255, 0.3);
  qproperty-GroupNameTextColor: #7fd3dc;
  qproperty-ChannelNameTextColor: #d6d9dc;
  qproperty-ColumnHeaderBorderColor: #24262a;
  qproperty-SelectedEmptyColor: rgba(50, 150, 168, 0.35);
  qproperty-SelectedSceneRangeEmptyColor: rgba(50, 150, 168, 0.35);
  qproperty-KeyFrameColor: #c7873c;
  qproperty-KeyFrameBorderColor: #ffb054;
  qproperty-SelectedKeyFrameColor: #e0b480;
  qproperty-IgnoredKeyFrameColor: #b24a56;
  qproperty-SelectedIgnoredKeyFrameColor: #ce8d95;
  qproperty-InBetweenColor: #6a7078;
  qproperty-InBetweenBorderColor: #acb5c2;
  qproperty-SelectedInBetweenColor: #858f9b;
  qproperty-IgnoredInBetweenColor: #8f7e78;
  qproperty-SelectedIgnoredInBetweenColor: #a89a96;
}
SpreadsheetViewer QLineEdit {
  margin-top: 1;
}
SpreadsheetViewer QLineEdit:focus {
  border-radius: 0;
  border-width: 1;
  color: #000;
  border-color: #fff;
  background-color: #fff;
  selection-background-color: #bebebe;
  selection-color: #000;
}
#FunctionSegmentViewer QPushButton {
  margin: 0 1;
}
#ExpressionField {
  background-color: #e7e7e7;
  border: 1 solid #24262a;
  margin: 0;
}
