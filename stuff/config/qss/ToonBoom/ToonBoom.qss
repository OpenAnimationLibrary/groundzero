   File Browser
----------------------------------------------------------------------------- */
#DirTreeView {
  font-weight: normal;
  background-color: #2f3236;
  alternate-background-color: #2f3236;
  border: 1 solid #24262a;
  border-right: 0;
}
#DirTreeView::branch {
  background-color: transparent;
}
#DirTreeView::branch:adjoins-item {
