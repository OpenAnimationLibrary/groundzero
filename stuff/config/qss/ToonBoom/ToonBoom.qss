----------------------------------------------------------------------------- */
#toolOptionsPanel QPushButton {
  background-color: #4d5157;
  border-color: #5c6066;
  border-width: 1;
  border-style: solid;
  border-radius: 3px;
  color: #d6d9dc;
  padding: 2px 12px;
  margin: 0;
  padding: 0;
}
#toolOptionsPanel QPushButton:hover {
  background-color: #585d63;
  border-color: #6a6f76;
  color: #d6d9dc;
}
#toolOptionsPanel QPushButton:pressed {
  background-color: #33363a;
  border-color: #5c6066;
  color: #d6d9dc;
}
#toolOptionsPanel QPushButton:checked {
  background-color: #3296a8;
  border-color: #3296a8;
