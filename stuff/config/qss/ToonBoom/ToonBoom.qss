PopupButton::menu-indicator {
  border-left: 0;
  height: 17;
  image: url('../Default/imgs/white/combobox/combo_downarrow.svg');
  width: 10;
}
PopupButton::menu-indicator:hover {
  image: url('../Default/imgs/white/combobox/combo_downarrow.svg');
}
PopupButton::menu-indicator:disabled {
  image: url('../Default/imgs/white/combobox/combo_downarrow_disabled.svg');
}
#Cap,
#Join {
  padding: 0 4 0 -8;
  max-width: 32;
  min-width: 32;
}
#Cap QMenu,
#Join QMenu {
  max-width: 28;
  min-width: 28;
}
#Cap QMenu::item,
#Join QMenu::item {
  max-width: 28;
  min-width: 28;
  padding: 0;
}
/* -----------------------------------------------------------------------------
   ComboViewer / Viewer / FlipBook
----------------------------------------------------------------------------- */
#ComboViewerPanel Toolbar {
  border-bottom: 1 solid #24262a;
}
#ComboViewerPanel Toolbar::separator:horizontal {
  margin: 0 0 1 2;
  padding: 0;
}
#ComboViewerPanel Toolbar QToolButton {
  margin: 2 0 3 2;
  padding: 1 0 0 1;
}
#ComboViewerPanel Toolbar QToolButton#qt_toolbar_ext_button {
  margin: 0;
  margin-bottom: 1;
  padding-top: 4;
  background-image: url('../Default/imgs/white/misc/toolbar_extension_horizontal.png');
}
#ComboViewerToolOptions {
  border-bottom: 1 solid #24262a;
}
#ComboViewerToolOptions #ScrollLeftButton,
#ComboViewerToolOptions #ScrollRightButton {
  background-color: #4d5157;
  border-width: 1;
  border-style: solid;
  border-color: #5c6066;
  border-radius: 0;
  padding: 0;
  margin: 0;
  width: 20;
  max-width: 20;
  height: 20;
  max-height: 20;
  margin-top: -1;
  margin-bottom: -1;
}
#ComboViewerToolOptions #ScrollLeftButton:hover,
#ComboViewerToolOptions #ScrollRightButton:hover {
  background-color: #585d63;
  border-color: #5c6066;
}
#ComboViewerToolOptions #ScrollLeftButton:pressed,
#ComboViewerToolOptions #ScrollRightButton:pressed {
  background-color: #33363a;
  border-color: #5c6066;
}
#ComboViewerToolOptions #ScrollLeftButton:disabled,
#ComboViewerToolOptions #ScrollRightButton:disabled {
  background-color: #46494f;
  border-color: #5c6066;
  color: rgba(214, 217, 220, 0.4);
}
#ComboViewerToolOptions #ScrollRightButton {
  image: url('../Default/imgs/white/scrollbar/scroll-right.svg');
  margin-top: -1;
  margin-bottom: -1;
  margin-right: -1;
}
#ComboViewerToolOptions #ScrollRightButton:hover {
  image: url('../Default/imgs/white/scrollbar/scroll-right-hover.svg');
}
#ComboViewerToolOptions #ScrollLeftButton {
  image: url('../Default/imgs/white/scrollbar/scroll-left.svg');
  margin-top: -1;
  margin-bottom: -1;
  margin-left: -1;
}
#ComboViewerToolOptions #ScrollLeftButton:hover {
  image: url('../Default/imgs/white/scrollbar/scroll-left-hover.svg');
}
#ComboViewer #ToolBarContainer,
#ViewerPanel #ToolBarContainer,
FlipBook #ToolBarContainer {
  background-color: transparent;
  border-top: 1 solid #24262a;
  border-bottom: 1 solid #24262a;
}
#ComboViewer #ToolBarContainer #ScrollRightButton,
#ViewerPanel #ToolBarContainer #ScrollRightButton,
FlipBook #ToolBarContainer #ScrollRightButton {
  margin-right: 0;
  /* #ScrollRightButton has a border and the right side is
                          hidden with margin-right -1 by default. We want the
                          border to show here so we'll reset it. */
}
#flipCustomize {
  background-color: transparent;
  border: 1 solid transparent;
  border-radius: 3px;
  color: #d6d9dc;
  padding-top: -1;
  padding-right: -1;
  padding-bottom: -2;
  padding-left: 0;
  margin-left: 3;
}
#flipCustomize:hover {
  background-color: #4f5359;
  border-color: #4f5359;
  color: #d6d9dc;
}
#flipCustomize:pressed {
  background-color: #2d2f32;
  border-color: #2d2f32;
  color: white;
}
#flipCustomize:checked {
  background-color: #3296a8;
  border-color: #3296a8;
  color: white;
}
#flipCustomize:checked:hover {
  background-color: #3ba6b8;
  border-color: #3ba6b8;
}
#flipCustomize:checked:pressed {
  background-color: #277685;
}
#flipCustomize:disabled {
  color: rgba(214, 217, 220, 0.4);
  background-color: transparent;
}
#flipCustomize:disabled:checked {
  background-color: #37616b;
  border-color: #37616b;
}
#flipCustomize::menu-button {
  background-color: transparent;
  width: 35;
}
#flipCustomize::menu-arrow {
  image: none;
}
QToolBar#FlipConsolePlayToolBar::separator:horizontal {
  border-color: #4a4e54;
  margin: 0 1 0 1;
}
QToolBar#FlipConsolePlayToolBar QToolButton {
  margin: 2 1 2 1;
  padding-left: 2;
  padding-right: 1;
}
QToolBar#FlipConsolePlayToolBar #KeyNo,
QToolBar#FlipConsolePlayToolBar #KeyPartial,
QToolBar#FlipConsolePlayToolBar #KeyTotal,
QToolBar#FlipConsolePlayToolBar #PreviousKey,
QToolBar#FlipConsolePlayToolBar #NextKey {
  padding-right: 1;
  padding-left: 1;
  max-width: 20;
  max-height: 20;
  padding-top: 0;
  padding-bottom: 0;
}
QToolBar#FlipConsolePlayToolBar #PreviousKey,
QToolBar#FlipConsolePlayToolBar #NextKey {
  margin: 0 2;
}
#ViewerFpsSlider {
  background-color: transparent;
  background-image: url('../Default/imgs/white/slider/slider-groove-dark.svg');
  background-repeat: repeat-x;
  background-position: center center;
  height: 21;
  margin: 0 3 0 37;
  max-width: 500;
  min-width: 0;
}
#ViewerFpsSlider::sub-line:horizontal {
  subcontrol-origin: absolute;
  background-color: #4d5157;
  border: 1 solid #24262a;
  border-top-left-radius: 2;
  border-bottom-left-radius: 2;
  height: 19;
  left: -33;
  width: 14;
}
#ViewerFpsSlider::add-line:horizontal {
  subcontrol-position: left;
  background-color: #4d5157;
  border: 1 solid #24262a;
  border-top-right-radius: 2;
  border-bottom-right-radius: 2;
  left: 18;
  height: 19;
  image-position: center center;
  width: 13;
}
#ViewerFpsSlider::sub-line:horizontal:hover,
#ViewerFpsSlider::add-line:horizontal:hover {
  background-color: #585d63;
  border-color: #24262a;
  color: #d6d9dc;
}
#ViewerFpsSlider::sub-line:horizontal:pressed,
#ViewerFpsSlider::add-line:horizontal:pressed {
  background-color: #33363a;
}
#ViewerFpsSlider::sub-line:horizontal:disabled,
#ViewerFpsSlider::add-line:horizontal:disabled {
  background-color: #46494f;
  border-color: rgba(92, 96, 102, 0.3);
  color: rgba(214, 217, 220, 0.4);
}
#ViewerFpsSlider::handle::horizontal {
  background-color: #aeb4bb;
  border: 1 solid #aeb4bb;
  border-radius: 2;
  margin: 2 0 3 0;
  min-width: 9;
  width: 9;
  max-width: 9;
}
#ViewerFpsSlider::handle::horizontal:hover {
  background-color: #c7cbd0;
}
#ViewerFpsSlider::handle::horizontal:pressed {
  background-color: #959da6;
}
FlipConsole {
  qproperty-FpsFieldColor: #26282a;
}
FlipSlider {
  qproperty-PBHeight: 20;
  qproperty-PBOverlay: url('../Default/imgs/white/flipslider/flipslider-dark-hc.svg');
  qproperty-PBColorMarginLeft: 1;
  qproperty-PBColorMarginTop: 3;
  qproperty-PBColorMarginRight: 1;
  qproperty-PBColorMarginBottom: 3;
  qproperty-PBMarker: url('../Default/imgs/white/flipslider/flipmarker-toonboom.svg');
  qproperty-PBMarkerMarginLeft: 4;
  qproperty-PBMarkerMarginRight: 4;
  qproperty-notStartedColor: hsl(0, 45%, 40%);
  qproperty-startedColor: hsl(150, 42%, 42%);
  qproperty-baseColor: #2d2f32;
  qproperty-finishedColor: #2d2f32;
}
Ruler {
  qproperty-ParentBGColor: #343639;
  qproperty-ScaleColor: rgba(214, 217, 220, 0.7);
  qproperty-HandleColor: #5fe3f0;
  qproperty-HandleDragColor: #ffd34d;
  qproperty-BorderColor: #24262a;
}
#RulerToolOptionValues {
  color: #000;
}
#enableBlankFrameButton {
  background-color: #4d5157;
  border-color: #5c6066;
  border-width: 1;
  border-style: solid;
  border-radius: 3px;
  color: #d6d9dc;
  padding: 2px 12px;
  background-color: transparent;
  border-color: transparent;
  color: rgba(214, 217, 220, 0.4);
  padding: 0;
  font-weight: bold;
  margin: 0;
}
#enableBlankFrameButton:hover {
  background-color: #585d63;
  border-color: #6a6f76;
  color: #d6d9dc;
}
#enableBlankFrameButton:pressed {
  background-color: #33363a;
  border-color: #5c6066;
  color: #d6d9dc;
}
#enableBlankFrameButton:checked {
  background-color: #3296a8;
  border-color: #3296a8;
  color: white;
}
#enableBlankFrameButton:checked:hover {
  background-color: #3ba6b8;
  border-color: #3296a8;
}
#enableBlankFrameButton:checked:pressed {
  background-color: #33363a;
}
#enableBlankFrameButton:disabled {
  background-color: #46494f;
  border-color: rgba(92, 96, 102, 0.3);
  color: rgba(214, 217, 220, 0.4);
}
#enableBlankFrameButton:checked {
  border-width: 2;
  border-color: #24262a;
}
#enableBlankFrameButton:checked:hover {
  border-color: #24262a;
}
/* -----------------------------------------------------------------------------
   Task Viewer
----------------------------------------------------------------------------- */
#TaskSheetItem,
#tasksRemoveBox,
#tasksAddBox {
  background-color: #26282a;
  border-style: solid;
  border-width: 1;
  border-color: #4a4e54;
  border-radius: 3px;
  color: #d6d9dc;
  selection-background-color: rgba(50, 150, 168, 0.75);
  selection-color: white;
  padding: 1 0 1 1;
}
#TaskSheetItem:hover,
#tasksRemoveBox:hover,
#tasksAddBox:hover {
  background-color: #26282a;
  color: #d6d9dc;
  border-color: #5c6066;
}
#TaskSheetItem:focus,
#tasksRemoveBox:focus,
#tasksAddBox:focus {
  background-color: #26282a;
  border-color: #3296a8;
  color: white;
}
#TaskSheetItem:disabled,
#tasksRemoveBox:disabled,
#tasksAddBox:disabled {
  background: none;
  color: #74777a;
  background-color: #333538;
  border-color: rgba(74, 78, 84, 0.4);
}
#TaskSheetItemLabel {
  color: #7fd3dc;
}
#Tasks QToolBar {
  border-bottom: 1 solid #24262a;
  margin: 0;
  padding: 0;
}
#Tasks QToolBar::separator:horizontal {
  margin: 0 0 1 0;
}
#Tasks QToolBar QToolButton {
  margin: 2 2 3 2;
}
