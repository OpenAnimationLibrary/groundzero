}
#EditToolLockButton::indicator:disabled:checked {
  background-color: #37616b;
  border-color: #37616b;
}
#EditToolLockButton::indicator:hover {
  background-color: #4f5359;
  border-color: #4f5359;
  color: #d6d9dc;
}
#EditToolLockButton::indicator:pressed {
  background-color: #2d2f32;
  border-color: #2d2f32;
  color: white;
}
#EditToolLockButton::indicator:checked {
  background-color: #3296a8;
  border-color: #3296a8;
  color: white;
}
#EditToolLockButton::indicator:checked:hover {
  background-color: #3ba6b8;
  border-color: #3ba6b8;
}
#EditToolLockButton::indicator:checked:pressed {
  background-color: #277685;
}
#EditToolLockButton::indicator:disabled {
