  border-color: #37616b;
}
#CameraSettingsRadioButton::indicator:unchecked {
  image: url('../Default/imgs/white/lock/lock.svg');
}
#CameraSettingsRadioButton::indicator:unchecked:hover {
  image: url('../Default/imgs/white/lock/lock_over.svg');
}
#CameraSettingsRadioButton::indicator:unchecked:pressed {
  background-color: #2d2f32;
  border-color: #2d2f32;
}
#CameraSettingsRadioButton::indicator:checked {
  background-color: #d9534f;
  border-color: #d9534f;
  image: url('../Default/imgs/white/lock/lock_on.svg');
}
#CameraSettingsRadioButton::indicator:checked:hover {
  background-color: #e17875;
  border-color: #e17875;
}
#CameraSettingsRadioButton::indicator:checked:hover:pressed {
  background-color: #ce312c;
  border-color: #d9534f;
}
#CameraSettingsRadioButton::indicator:checked:pressed {
  background-color: #ce312c;
  border-color: #d9534f;
}
#CameraSettingsRadioButton::indicator:hover {
  background-color: #4f5359;
  border-color: #4f5359;
}
#CameraSettingsDPI {
  color: #7fd3dc;
}
#CameraSettingsRadioButton_Small {
  padding: 0;
}
#CameraSettingsRadioButton_Small::indicator {
  width: 13;
  height: 13;
  image-position: center center;
  background-color: transparent;
  border: 0;
  margin: 0;
}
#CameraSettingsRadioButton_Small::indicator:unchecked {
  image: url('../Default/imgs/white/radiobutton/radiobutton_unchecked.svg');
}
#CameraSettingsRadioButton_Small::indicator:unchecked:hover {
  image: url('../Default/imgs/white/radiobutton/radiobutton_unchecked_hover.svg');
}
#CameraSettingsRadioButton_Small::indicator:checked {
  image: url('../Default/imgs/white/radiobutton/radiobutton_checked.svg');
}
#CameraSettingsRadioButton_Small::indicator:checked:disabled {
  background-color: transparent;
  image: url('../Default/imgs/white/radiobutton/radiobutton_checked_disabled.svg');
}
#CameraSettingsRadioButton_Small::indicator:disabled {
  image: url('../Default/imgs/white/radiobutton/radiobutton_unchecked_disabled.svg');
}
#ForceSquaredPixelButton {
  background-color: transparent;
  border: 1 solid transparent;
  border-radius: 3px;
  color: #d6d9dc;
  padding-top: -1;
  padding-right: -1;
  padding-bottom: -2;
  padding-left: 0;
  margin: 0;
  height: 16;
  width: 16;
  padding: 2;
}
#ForceSquaredPixelButton:hover {
  background-color: #4f5359;
  border-color: #4f5359;
  color: #d6d9dc;
}
#ForceSquaredPixelButton:pressed {
  background-color: #2d2f32;
  border-color: #2d2f32;
  color: white;
}
#ForceSquaredPixelButton:checked {
  background-color: #3296a8;
  border-color: #3296a8;
  color: white;
}
#ForceSquaredPixelButton:checked:hover {
  background-color: #3ba6b8;
  border-color: #3ba6b8;
}
#ForceSquaredPixelButton:checked:pressed {
  background-color: #277685;
}
#ForceSquaredPixelButton:disabled {
  color: rgba(214, 217, 220, 0.4);
  background-color: transparent;
}
#ForceSquaredPixelButton:disabled:checked {
  background-color: #37616b;
  border-color: #37616b;
}
/* -----------------------------------------------------------------------------
   Output Settings
----------------------------------------------------------------------------- */
#OutputSettingsLabel {
  color: #7fd3dc;
}
#OutputSettingsBox {
  background-color: transparent;
  border-width: 1;
  border-style: solid;
  border-radius: 3px;
  border-color: #4a4e54;
}
#OutputSettingsCameraBox {
  background-color: transparent;
  border-width: 1;
  border-style: solid;
  border-radius: 3px;
  border-color: #4a4e54;
}
/* -----------------------------------------------------------------------------
   Palette Viewer / Studio Palette
----------------------------------------------------------------------------- */
PaletteViewer DvScrollWidget QPushButton {
  margin-bottom: 0;
  max-width: 15;
  min-width: 15;
}
PaletteViewer QToolBar {
  background: transparent;
}
PaletteViewer QToolBar::separator:horizontal {
  margin: 0;
}
PaletteViewer QToolBar QToolButton {
  background-color: none;
  border: 0;
  border-radius: 0;
  margin: 0;
  padding: 0;
  padding-right: -2;
  padding-left: -1;
}
PaletteViewer QToolBar QToolButton:hover {
  background-color: #4f5359;
}
PaletteViewer QToolBar QToolButton:pressed {
  background-color: #2d2f32;
}
PaletteViewer QToolBar #keyFrameNavigator #NextKey,
PaletteViewer QToolBar #keyFrameNavigator #PreviousKey,
PaletteViewer QToolBar #keyFrameNavigator #KeyNo,
PaletteViewer QToolBar #keyFrameNavigator #KeyPartial,
PaletteViewer QToolBar #keyFrameNavigator #KeyTotal {
  max-width: 20;
  max-height: 20;
  padding: 1;
  border: 0;
  margin: 0;
}
#StudioPalette QTreeView {
  background-color: #3b3e42;
  alternate-background-color: #3b3e42;
}
#PageViewer {
  qproperty-TextColor: #d6d9dc;
  qproperty-SelectedBorderColor: #ffffff;
  qproperty-NumpadShortcutBgColor: rgba(0, 0, 0, 0.3);
  qproperty-NumpadShortcutBorderColor: #8e949d;
  qproperty-SeparatorColor: #24262a;
  qproperty-CurrentCellColor: rgba(50, 150, 168, 0.5);
  qproperty-SelectedCellColor: #3296a8;
  qproperty-ListNumpadShortcutBorderColor: #afafaf;
}
#PaletteLockButton {
  border-radius: 0;
}
#PaletteLockButton:checked {
  background-color: #d9534f;
  border-color: #d9534f;
}
#PaletteLockButton:checked:hover {
  background-color: #e17875;
  border-color: #e17875;
}
#PaletteLockButton:checked:disabled {
  background-color: rgba(217, 83, 79, 0.4);
  border-color: rgba(217, 83, 79, 0.4);
}
#PltPageViewerScrollArea {
  border-bottom: 1 solid #24262a;
}
/* -----------------------------------------------------------------------------
   Quick Renamer
----------------------------------------------------------------------------- */
#WordButton {
  background-color: #4d5157;
  border-color: #5c6066;
  border-width: 1;
  border-style: solid;
  border-radius: 3px;
  color: #d6d9dc;
  margin: 0;
  padding: 2px 12px;
  padding-right: 0;
  padding-left: 0;
}
#WordButton:hover {
  background-color: #585d63;
  border-color: #6a6f76;
  color: #d6d9dc;
}
#WordButton:pressed {
  background-color: #33363a;
  border-color: #5c6066;
  color: #d6d9dc;
}
#WordButton:checked {
  background-color: #3296a8;
  border-color: #3296a8;
  color: white;
}
#WordButton:checked:hover {
  background-color: #3ba6b8;
  border-color: #3296a8;
}
#WordButton:checked:pressed {
  background-color: #33363a;
}
#WordButton:disabled {
  background-color: #46494f;
  border-color: rgba(92, 96, 102, 0.3);
  color: rgba(214, 217, 220, 0.4);
}
#SolidLineFrame {
  background-color: transparent;
  border-width: 1;
  border-style: solid;
  border-radius: 3px;
  border-color: #4a4e54;
}
/* -----------------------------------------------------------------------------
   Keyframe Navigator
----------------------------------------------------------------------------- */
#keyFrameNavigator {
  background: transparent;
  margin: 0;
  padding: 0;
}
#keyFrameNavigator #PreviousKey,
#keyFrameNavigator #NextKey,
#keyFrameNavigator #KeyNo,
#keyFrameNavigator #KeyPartial,
#keyFrameNavigator #KeyTotal {
  margin: 0 2px;
  padding-right: -1px;
  width: 20px;
  height: 20px;
}
#keyFrameNavigator #KeyNo {
  background-color: transparent;
  border: 1px solid transparent;
}
#keyFrameNavigator #KeyNo:hover {
  background-color: #4f5359;
  border-color: #4f5359;
}
#keyFrameNavigator #KeyNo:pressed {
  background-color: #2d2f32;
  border-color: #2d2f32;
}
#keyFrameNavigator #KeyPartial {
  background-color: #e3a23a;
  border: 1px solid #e3a23a;
}
#keyFrameNavigator #KeyPartial::hover {
  background-color: #e9b562;
  border-color: #e3a23a;
}
#keyFrameNavigator #KeyPartial:pressed {
  background-color: #d18c1e;
  border-color: #e3a23a;
}
#keyFrameNavigator #KeyTotal {
  background-color: #e3a23a;
  border: 1px solid #e3a23a;
}
#keyFrameNavigator #KeyTotal:hover {
  background-color: #e9b562;
  border-color: #e3a23a;
}
#keyFrameNavigator #KeyTotal:pressed {
  background-color: #d18c1e;
  border-color: #e3a23a;
}
#keyFrameNavigator QToolButton#qt_toolbar_ext_button {
  padding-bottom: 3;
  border-radius: 2;
}
/* -----------------------------------------------------------------------------
   Popup Windows
----------------------------------------------------------------------------- */
QDialog {
  background-color: #3b3e42;
}
QDialog #dialogButtonFrame {
  background-color: #343639;
  border-top: 1 solid #4a4e54;
}
QDialog #dialogButtonFrame QPushButton {
  outline: 0;
}
QDialog #dialogButtonFrame QPushButton:focus {
  background-color: #3296a8;
  border-color: #3ba6b8;
  color: white;
}
QDialog #dialogButtonFrame QPushButton:focus:hover {
  background-color: #41b2c7;
  border-color: #41b2c7;
}
QDialog #dialogButtonFrame QPushButton:focus:pressed {
  background-color: #33363a;
  border-color: #5c6066;
  color: #d6d9dc;
}
/* -----------------------------------------------------------------------------
   Scene Settings
----------------------------------------------------------------------------- */
#SceneSettings QLabel {
  color: #7fd3dc;
}
/* -----------------------------------------------------------------------------
   Preferences
----------------------------------------------------------------------------- */
#PreferencesPopup QListWidget,
#OutputSettingsPopup QListWidget {
  background-color: #2f3236;
  alternate-background-color: #2f3236;
  border: 1 solid #4a4e54;
  font-size: 13px;
}
#PreferencesPopup QListWidget::item,
#OutputSettingsPopup QListWidget::item {
  border: 0;
  padding: 3;
}
#PreferencesPopup QListWidget::item:hover,
#OutputSettingsPopup QListWidget::item:hover {
  background-color: #44494f;
  color: white;
}
#PreferencesPopup QListWidget::item:selected,
#OutputSettingsPopup QListWidget::item:selected {
  background-color: #3296a8;
  color: white;
}
#PreferencesPopup QListWidget::item:selected:hover,
#OutputSettingsPopup QListWidget::item:selected:hover {
  background-color: #41b2c7;
}
/* -----------------------------------------------------------------------------
   Keyboard Shortcuts
----------------------------------------------------------------------------- */
#ShortcutTree {
  border: 1 solid #24262a;
}
#ShortcutTree::item {
  padding: 1 0;
}
#ShortcutTree QScrollBar:vertical {
  width: 16;
  margin-right: -1;
}
#ShortcutViewer {
  font-size: 17;
}
#ShortcutViewer QLineEdit {
  color: black;
  border-color: #b8bc7f;
  background-color: white;
}
#ShortcutViewer QLineEdit:focus {
  background-color: #abceff;
}
/* -----------------------------------------------------------------------------
   New Project / Configure Project Window
----------------------------------------------------------------------------- */
ProjectPopup QLabel {
  color: #7fd3dc;
}
/* -----------------------------------------------------------------------------
