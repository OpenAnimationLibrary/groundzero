* {
  padding: 0;
  margin: 0;
  outline: 0;
  border: 0;
  border-style: none;
  border-image: none;
}
QToolBar * {
  padding: 0;
  margin: 0;
}
:TOONZCOLORS {
  -bg-color: #3b3e42;
  -hl-color: #3296a8;
  -icon-base-opacity: 0.8;
  -icon-disabled-opacity: 0.3;
  -icon-base-color: #d6d9dc;
  -icon-active-color: white;
  -icon-selected-color: white;
  -icon-on-color: white;
  -icon-close-color: white;
  -icon-preview-color: black;
  -icon-vcheck-color: white;
  -icon-lock-color: white;
  -icon-keyframe-color: white;
  -icon-keyframe-modified-color: white;
}
QWidget {
  background-color: #3b3e42;
  color: #d6d9dc;
}
QWidget:disabled {
  color: rgba(214, 217, 220, 0.4);
}
/* -----------------------------------------------------------------------------
   MainWindow & Floating Panels
----------------------------------------------------------------------------- */
QFrame {
  border: 0;
  margin: 0;
  padding: 0;
}
QToolTip,
#helpToolTip {
  background-color: #1f2123;
  border: 1 solid #55595f;
  color: #e3e6e9;
  padding: 2px;
}
#DockSeparator,
QMainWindow::separator,
QSplitter::handle {
  background-color: #1f2123;
  height: 4;
  width: 4;
}
#TDockPlaceholder {
  background-color: #1aff00;
}
TPanel {
  background-color: #1f2123;
}
/* -----------------------------------------------------------------------------
   Topbar
----------------------------------------------------------------------------- */
#TopBar {
  background-color: #343639;
  border: 0;
  border-bottom: 1 solid #24262a;
  margin: 0;
}
#TopBar #EditToolLockButton {
  background-color: #343639;
  spacing: 0;
}
#TopBar #EditToolLockButton::indicator {
  background: none;
  border: none;
  padding-left: 0;
  padding-right: 0;
}
#TopBarTabContainer {
  background-color: #343639;
  margin-bottom: 1;
}
#StackedMenuBar {
  border: 0;
  margin: 0;
  padding: 0;
}
QMenuBar {
  background-color: #343639;
  border: 0;
}
QMenuBar::item {
  background-color: #343639;
  border-left: 1 solid #343639;
  padding: 3 5;
}
QMenuBar::item:selected {
  background-color: #45484d;
  color: white;
}
QMenuBar::item:pressed {
  background-color: #3296a8;
  color: white;
}
/* -----------------------------------------------------------------------------
   Rooms Workspaces
----------------------------------------------------------------------------- */
#TopBarTab {
  margin: 0;
  padding: 0;
  border: 0;
  background-color: transparent;
}
#TopBarTab::tab {
  background-color: #2d2f32;
  padding: 2 8 3 8;
  margin: 0 -1 0 0;
  border-color: #24262a;
  border-radius: 0;
  border-bottom-width: 0;
}
#TopBarTab::tab:hover {
  background-color: #35383c;
}
#TopBarTab::tab:selected {
  background-color: #3296a8;
  border-color: #24262a;
  color: white;
}
#TopBarTab::tab:selected:hover {
  background-color: #3ba6b8;
}
#TopBarTab::tab:first {
  border-left-width: 1;
  border-top-left-radius: 2;
}
#TopBarTab::tab:last {
  margin-right: 0;
  border-top-right-radius: 2;
}
#TopBarTab::tab:only-one {
  border-left-width: 1;
}
#TopBarTab QToolButton {
  border-left: 2 solid #24262a;
  border-top: 1 solid #24262a;
  border-right: 1 solid #24262a;
  border-bottom: 0;
  margin-left: -1;
  margin-top: 0;
}
/* -----------------------------------------------------------------------------
   Context Menu
----------------------------------------------------------------------------- */
QMenu {
  background-color: #2f3236;
  border: 1 solid #4a4e54;
  color: #d6d9dc;
  padding: 2 0;
}
QMenu::item {
  border: 0;
  padding: 3 28 3 14;
}
QMenu::item:selected {
  background-color: #3296a8;
  color: white;
}
QMenu::item:checked {
  color: #7fd3dc;
  background-color: #2f3236;
  font-weight: bold;
}
QMenu::item:checked:selected {
  background-color: #3296a8;
  color: white;
}
QMenu::item:disabled {
  background: none;
  color: rgba(214, 217, 220, 0.4);
}
QMenu::item:disabled:selected {
  color: rgba(214, 217, 220, 0.4);
}
QMenu::separator {
  border-top: 1 solid #4a4e54;
  height: 0;
  margin: 2 0;
}
QMenu::icon {
  border-radius: 2;
  position: absolute;
  left: 7;
  padding: 0;
  margin: 0;
  qproperty-icon: url('../Default/imgs/white/misc/transparent_16x16.png');
}
QMenu::icon:checked {
  background-color: #3296a8;
  border: 1 solid #3296a8;
}
QMenu::indicator {
  margin-left: 8;
}
QMenu::indicator:non-exclusive {
  background-color: #26282a;
  border: 1 solid #6b7078;
  border-radius: 2px;
  padding: 1;
  width: 10px;
  height: 10px;
  border-color: #6b7078;
}
QMenu::indicator:non-exclusive:hover {
  background-color: #3c3f42;
  border-color: #8e949d;
}
QMenu::indicator:non-exclusive:checked {
  background-color: #3296a8;
  border-color: #3296a8;
  image: url('../Default/imgs/white/checkmark/checkmark.svg');
}
QMenu::indicator:non-exclusive:checked:hover {
  background-color: #3ba6b8;
  border-color: #3ba6b8;
}
QMenu::indicator:non-exclusive:checked:disabled {
  background-color: #36737f;
  border-color: #36737f;
  image: url('../Default/imgs/white/checkmark/checkmark_disabled.svg');
}
QMenu::indicator:non-exclusive:indeterminate {
  background-color: #3296a8;
  border-color: #3296a8;
  image: url('../Default/imgs/white/checkmark/checkpartially.svg');
}
QMenu::indicator:non-exclusive:indeterminate:hover {
  background-color: #3c3f42;
  border-color: #8e949d;
}
QMenu::indicator:non-exclusive:indeterminate:disabled {
  background-color: #37616b;
  border-color: #37616b;
  image: url('../Default/imgs/white/checkmark/checkpartially_disabled.svg');
}
QMenu::indicator:non-exclusive:disabled {
  background-color: #333538;
  border-color: #4e5258;
}
QMenu::indicator:non-exclusive:selected,
QMenu::indicator:non-exclusive:hover {
  border-color: #8e949d;
}
QMenu::indicator:non-exclusive:checked {
  border-color: #3296a8;
}
QMenu::indicator:non-exclusive:checked:selected {
  border-color: #3296a8;
}
QMenu::indicator:exclusive {
  width: 13;
  height: 13;
  background-color: transparent;
  border: 0;
  image-position: center center;
}
QMenu::indicator:exclusive:unchecked {
  image: url('../Default/imgs/white/radiobutton/radiobutton_unchecked.svg');
}
QMenu::indicator:exclusive:unchecked:hover {
  image: url('../Default/imgs/white/radiobutton/radiobutton_unchecked_hover.svg');
}
QMenu::indicator:exclusive:checked {
  image: url('../Default/imgs/white/radiobutton/radiobutton_checked.svg');
}
QMenu::indicator:exclusive:checked:disabled {
  background-color: transparent;
  image: url('../Default/imgs/white/radiobutton/radiobutton_checked_disabled.svg');
}
QMenu::indicator:exclusive:disabled {
  image: url('../Default/imgs/white/radiobutton/radiobutton_unchecked_disabled.svg');
}
/* -----------------------------------------------------------------------------
   Titlebars
----------------------------------------------------------------------------- */
TPanelTitleBar {
  background-color: #343639;
  border-bottom: 1 solid #24262a;
  border-top-left-radius: 0px;
  border-top-right-radius: 0px;
  height: 18;
  min-height: 18;
  qproperty-TitleColor: #9aa0a6;
  qproperty-ActiveTitleColor: #ffffff;
  qproperty-CloseOverColor: #d9534f;
  font-weight: bold;
  qproperty-BorderPixmap: url('../Default/imgs/white/misc/transparent_16x16.png');
  qproperty-ActiveBorderPixmap: url('../Default/imgs/white/misc/transparent_16x16.png');
  qproperty-FloatBorderPixmap: url('../Default/imgs/white/misc/transparent_16x16.png');
  qproperty-FloatActiveBorderPixmap: url('../Default/imgs/white/misc/transparent_16x16.png');
}
TPanelTitleBar:hover {
  background-color: #343639;
}
TPanelTitleBarButton {
  qproperty-OffColor: #343639;
  qproperty-OverColor: #4f5359;
  qproperty-PressedColor: #3296a8;
  qproperty-FreezeColor: #d9534f;
  qproperty-PreviewColor: #dcc85a;
}
/* -----------------------------------------------------------------------------
   Scrollbars
----------------------------------------------------------------------------- */
QAbstractScrollArea::corner {
  background-color: #2d2f32;
}
QScrollBar {
  background-color: #2d2f32;
  border: 0;
}
QScrollBar:horizontal {
  height: 15;
  margin: 0;
}
QScrollBar:vertical {
  margin: 0;
  width: 15;
}
QScrollBar::handle {
  background-color: #5a5f66;
  border-style: solid;
  border-width: 1;
  border-color: #5a5f66;
  border-radius: 4px;
}
QScrollBar::handle:horizontal:hover,
QScrollBar::handle:vertical:hover {
  background-color: #6a6f76;
  border-color: #6a6f76;
}
QScrollBar::handle:horizontal:pressed,
QScrollBar::handle:vertical:pressed {
  background-color: #7a8088;
  border-color: #7a8088;
}
QScrollBar::handle:horizontal {
  margin: 2px 16;
  min-width: 20;
}
QScrollBar::handle:vertical {
  margin: 16 2px;
  min-height: 20;
}
QScrollBar::add-line {
  subcontrol-origin: margin;
  border: 0;
}
QScrollBar::add-line:horizontal {
  subcontrol-position: right;
  background-color: #2d2f32;
  margin: 0;
  width: 16;
}
QScrollBar::add-line:vertical {
  subcontrol-position: bottom;
  background-color: #2d2f32;
  margin: 0;
  height: 16;
}
QScrollBar::sub-line {
  border: 0;
  subcontrol-origin: margin;
}
QScrollBar::sub-line:horizontal {
  subcontrol-position: left;
  background-color: #2d2f32;
  margin: 0;
  width: 16;
}
QScrollBar::sub-line:vertical {
  subcontrol-position: top;
  background-color: #2d2f32;
  margin: 0;
  height: 16;
}
QScrollBar::up-arrow:vertical {
  image: url('../Default/imgs/white/scrollbar/scroll-up.svg');
  image-position: center center;
}
QScrollBar::up-arrow:vertical:hover {
  image: url('../Default/imgs/white/scrollbar/scroll-up-hover.svg');
}
QScrollBar::up-arrow:vertical:pressed {
  margin: 1 0 0 0;
  image: url('../Default/imgs/white/scrollbar/scroll-up-hover.svg');
}
QScrollBar::down-arrow:vertical {
  image: url('../Default/imgs/white/scrollbar/scroll-down.svg');
  image-position: center center;
}
QScrollBar::down-arrow:vertical:hover {
  image: url('../Default/imgs/white/scrollbar/scroll-down-hover.svg');
}
QScrollBar::down-arrow:vertical:pressed {
  margin: 1 0 0 0;
  image: url('../Default/imgs/white/scrollbar/scroll-down-hover.svg');
}
QScrollBar::left-arrow:horizontal {
  image: url('../Default/imgs/white/scrollbar/scroll-left.svg');
  image-position: center center;
}
QScrollBar::left-arrow:horizontal:hover {
  image: url('../Default/imgs/white/scrollbar/scroll-left-hover.svg');
}
QScrollBar::left-arrow:horizontal:pressed {
  margin: 1 0 0 0;
  image: url('../Default/imgs/white/scrollbar/scroll-left-hover.svg');
}
QScrollBar::right-arrow:horizontal {
  image: url('../Default/imgs/white/scrollbar/scroll-right.svg');
  image-position: center center;
}
QScrollBar::right-arrow:horizontal:hover {
  image: url('../Default/imgs/white/scrollbar/scroll-right-hover.svg');
}
QScrollBar::right-arrow:horizontal:pressed {
  margin: 1 0 0 0;
  image: url('../Default/imgs/white/scrollbar/scroll-right.svg');
}
QScrollBar::sub-page:horizontal,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:vertical,
QScrollBar::add-page:vertical {
  background: none;
}
/* -----------------------------------------------------------------------------
   Progress Bar
----------------------------------------------------------------------------- */
QProgressBar {
  text-align: center;
  background-color: #2d2f32;
  border: 1 solid #24262a;
  border-radius: 3;
  padding: 0;
}
QProgressBar::chunk {
  margin: -1;
  background-color: #3296a8;
  border: 1 solid #24262a;
  border-radius: 2;
}
/* -----------------------------------------------------------------------------
   Buttons
----------------------------------------------------------------------------- */
QPushButton {
  background-color: #4d5157;
  border-color: #5c6066;
  border-width: 1;
  border-style: solid;
  border-radius: 3px;
  color: #d6d9dc;
  margin: 0;
  padding: 2px 12px;
}
QPushButton:hover {
  background-color: #585d63;
  border-color: #6a6f76;
  color: #d6d9dc;
}
QPushButton:pressed {
  background-color: #33363a;
  border-color: #5c6066;
  color: #d6d9dc;
}
QPushButton:checked {
  background-color: #3296a8;
  border-color: #3296a8;
  color: white;
}
QPushButton:checked:hover {
  background-color: #3ba6b8;
  border-color: #3296a8;
}
QPushButton:checked:pressed {
  background-color: #33363a;
}
QPushButton:disabled {
  background-color: #46494f;
  border-color: rgba(92, 96, 102, 0.3);
  color: rgba(214, 217, 220, 0.4);
}
#PushButton_NoPadding {
  padding: 3;
}
#CustomPanelButton {
  background-color: #4d5157;
  border-color: #5c6066;
  border-width: 1;
  border-style: solid;
  border-radius: 3px;
  color: #d6d9dc;
  margin: 0;
  padding: 2px 12px;
  padding: 0;
}
#CustomPanelButton:hover {
  background-color: #585d63;
  border-color: #6a6f76;
  color: #d6d9dc;
}
#CustomPanelButton:pressed {
  background-color: #33363a;
  border-color: #5c6066;
  color: #d6d9dc;
}
#CustomPanelButton:checked {
  background-color: #3296a8;
  border-color: #3296a8;
  color: white;
}
#CustomPanelButton:checked:hover {
  background-color: #3ba6b8;
  border-color: #3296a8;
}
#CustomPanelButton:checked:pressed {
  background-color: #33363a;
}
#CustomPanelButton:disabled {
  background-color: #46494f;
  border-color: rgba(92, 96, 102, 0.3);
  color: rgba(214, 217, 220, 0.4);
}
/* -----------------------------------------------------------------------------
   ComboBox
----------------------------------------------------------------------------- */
QComboBox {
  background-color: #4d5157;
  border-color: #5c6066;
  border-width: 1;
  border-style: solid;
  border-radius: 3px;
  color: #d6d9dc;
  margin: 0;
  padding: 1 0 1 4;
}
QComboBox:hover {
  background-color: #585d63;
  color: #d6d9dc;
  border-color: #6a6f76;
}
QComboBox:checked {
  border-color: #3296a8;
}
QComboBox:pressed {
  background-color: #4d5157;
  border-color: #3296a8;
  color: #d6d9dc;
}
QComboBox:pressed:focus {
  background-color: #4d5157;
  border-color: #3296a8;
}
QComboBox:disabled {
  background-color: #46494f;
  border-color: rgba(92, 96, 102, 0.3);
  color: rgba(214, 217, 220, 0.4);
}
QComboBox:focus {
  background-color: #4d5157;
  border-color: #3296a8;
}
QComboBox:focus:hover {
  background-color: #585d63;
}
QComboBox:editable {
  color: #d6d9dc;
  background: none;
  background-color: #26282a;
  border-color: #4a4e54;
  selection-background-color: rgba(50, 150, 168, 0.75);
  selection-color: white;
  padding: 1 0 1 3;
}
QComboBox:editable:hover {
  background-color: #26282a;
  border-color: #5c6066;
}
QComboBox:editable:checked {
  border-color: #3296a8;
}
QComboBox:editable:focus {
  border-color: #3296a8;
}
QComboBox::drop-down {
  border: 0 solid transparent;
  image: url('../Default/imgs/white/combobox/combo_downarrow.svg');
  image-position: center center;
  width: 16;
}
QComboBox::drop-down:disabled {
  image: url('../Default/imgs/white/combobox/combo_downarrow_disabled.svg');
}
QComboBox::drop-down:disabled:editable {
  background-color: #46494f;
}
QComboBox::drop-down:editable {
  background-color: #4d5157;
  border-left: 1 solid #24262a;
  border-top-right-radius: 0;
  border-bottom-right-radius: 0;
}
QComboBox::drop-down:editable:hover {
  background-color: #585d63;
}
QComboBox QAbstractItemView {
  background-color: #2f3236;
  selection-background-color: #3296a8;
  selection-color: white;
  border: 1 solid #4a4e54;
}
/* -----------------------------------------------------------------------------
   Textfields
----------------------------------------------------------------------------- */
QPlainTextEdit,
QLineEdit,
QTextEdit[readOnly="false"] {
  background-color: #26282a;
  border-style: solid;
  border-width: 1;
  border-color: #4a4e54;
  border-radius: 3px;
  color: #d6d9dc;
  selection-background-color: rgba(50, 150, 168, 0.75);
  selection-color: white;
  padding: 1 0 1 1;
}
QPlainTextEdit:hover,
QLineEdit:hover,
QTextEdit[readOnly="false"]:hover {
  background-color: #26282a;
  color: #d6d9dc;
  border-color: #5c6066;
}
QPlainTextEdit:focus,
QLineEdit:focus,
QTextEdit[readOnly="false"]:focus {
  background-color: #26282a;
  border-color: #3296a8;
  color: white;
}
QPlainTextEdit:disabled,
QLineEdit:disabled,
QTextEdit[readOnly="false"]:disabled {
  background: none;
  color: #74777a;
  background-color: #333538;
  border-color: rgba(74, 78, 84, 0.4);
}
QTextEdit[readOnly="true"] {
  background-color: #3b3e42;
  color: #d6d9dc;
  border: 0;
}
QTextEdit[readOnly="true"]:focus,
QTextEdit[readOnly="true"]:disabled {
  background-color: #3b3e42;
  color: #d6d9dc;
  border: 0;
}
/* -----------------------------------------------------------------------------
   Options
----------------------------------------------------------------------------- */
QCheckBox {
  color: #d6d9dc;
  padding: 0 2 0 0;
  border-radius: 2;
}
QCheckBox:hover {
  background-color: #45484d;
  color: #ffffff;
}
QCheckBox:disabled {
  color: rgba(214, 217, 220, 0.4);
}
QCheckBox::indicator {
  background-color: #26282a;
  border: 1 solid #6b7078;
  border-radius: 2px;
  padding: 1;
  width: 10px;
  height: 10px;
}
QCheckBox::indicator:hover {
  background-color: #3c3f42;
  border-color: #8e949d;
}
QCheckBox::indicator:checked {
  background-color: #3296a8;
  border-color: #3296a8;
  image: url('../Default/imgs/white/checkmark/checkmark.svg');
}
QCheckBox::indicator:checked:hover {
  background-color: #3ba6b8;
  border-color: #3ba6b8;
}
QCheckBox::indicator:checked:disabled {
  background-color: #36737f;
  border-color: #36737f;
  image: url('../Default/imgs/white/checkmark/checkmark_disabled.svg');
}
QCheckBox::indicator:indeterminate {
  background-color: #3296a8;
  border-color: #3296a8;
  image: url('../Default/imgs/white/checkmark/checkpartially.svg');
}
QCheckBox::indicator:indeterminate:hover {
  background-color: #3c3f42;
  border-color: #8e949d;
}
QCheckBox::indicator:indeterminate:disabled {
  background-color: #37616b;
  border-color: #37616b;
  image: url('../Default/imgs/white/checkmark/checkpartially_disabled.svg');
}
QCheckBox::indicator:disabled {
  background-color: #333538;
  border-color: #4e5258;
}
QRadioButton {
  color: #d6d9dc;
}
QRadioButton:hover {
  color: #ffffff;
}
QRadioButton:checked {
  color: #d6d9dc;
}
QRadioButton:disabled {
  color: rgba(214, 217, 220, 0.4);
}
QRadioButton::indicator {
  width: 13;
  height: 13;
  background-color: transparent;
  border: 0;
  image-position: center center;
}
QRadioButton::indicator:unchecked {
  image: url('../Default/imgs/white/radiobutton/radiobutton_unchecked.svg');
}
QRadioButton::indicator:unchecked:hover {
  image: url('../Default/imgs/white/radiobutton/radiobutton_unchecked_hover.svg');
}
QRadioButton::indicator:checked {
  image: url('../Default/imgs/white/radiobutton/radiobutton_checked.svg');
}
QRadioButton::indicator:checked:disabled {
  background-color: transparent;
  image: url('../Default/imgs/white/radiobutton/radiobutton_checked_disabled.svg');
}
QRadioButton::indicator:disabled {
  image: url('../Default/imgs/white/radiobutton/radiobutton_unchecked_disabled.svg');
}
/* -----------------------------------------------------------------------------
   GroupBox
----------------------------------------------------------------------------- */
QGroupBox {
  background-color: transparent;
  border-width: 1;
  border-style: solid;
  border-radius: 3px;
  border-color: #4a4e54;
  margin: 6 0 0 0;
  padding: 5 5;
}
QGroupBox::title {
  subcontrol-origin: margin;
  color: #d6d9dc;
  left: 15;
  margin: -2 0 0 0;
  padding: 0 3;
  border-radius: 2;
}
QGroupBox::title:hover {
  color: #ffffff;
  background-color: #45484d;
}
QGroupBox::title:disabled {
  color: rgba(214, 217, 220, 0.4);
}
QGroupBox::indicator {
  background-color: #26282a;
  border: 1 solid #6b7078;
  border-radius: 2px;
  padding: 1;
  width: 10px;
  height: 10px;
  subcontrol-origin: margin;
  margin-top: 2;
}
QGroupBox::indicator:hover {
  background-color: #3c3f42;
  border-color: #8e949d;
}
QGroupBox::indicator:checked {
  background-color: #3296a8;
  border-color: #3296a8;
  image: url('../Default/imgs/white/checkmark/checkmark.svg');
}
QGroupBox::indicator:checked:hover {
  background-color: #3ba6b8;
  border-color: #3ba6b8;
}
QGroupBox::indicator:checked:disabled {
  background-color: #36737f;
  border-color: #36737f;
  image: url('../Default/imgs/white/checkmark/checkmark_disabled.svg');
}
QGroupBox::indicator:indeterminate {
  background-color: #3296a8;
  border-color: #3296a8;
  image: url('../Default/imgs/white/checkmark/checkpartially.svg');
}
QGroupBox::indicator:indeterminate:hover {
  background-color: #3c3f42;
  border-color: #8e949d;
}
QGroupBox::indicator:indeterminate:disabled {
  background-color: #37616b;
  border-color: #37616b;
  image: url('../Default/imgs/white/checkmark/checkpartially_disabled.svg');
}
QGroupBox::indicator:disabled {
  background-color: #333538;
  border-color: #4e5258;
}
QGroupBox:disabled {
  color: rgba(214, 217, 220, 0.4);
}
/* -----------------------------------------------------------------------------
   Sliders
----------------------------------------------------------------------------- */
QSlider {
  background-color: transparent;
}
QSlider::sub-page {
  background-color: #24262a;
  border: 1 solid #24262a;
  border-radius: 2;
}
QSlider::sub-page:disabled {
  background-color: #353535;
  border-color: #323438;
}
QSlider::sub-page:horizontal {
  margin: 8px 0 8px 0;
}
QSlider::sub-page:vertical {
  margin: 1 8px 1 8px;
}
QSlider::add-page {
  background-color: #24262a;
  border: 1 solid #24262a;
  border-radius: 2;
}
QSlider::add-page:disabled {
  background-color: #323438;
  border-color: #323438;
}
QSlider::add-page:horizontal {
  margin: 8px 0 8px 0;
}
QSlider::add-page:vertical {
  margin: 0 8px 0 8px;
}
QSlider::groove {
  background-color: transparent;
  margin: 0;
}
QSlider::groove:horizontal {
  height: 20;
  min-height: 20;
}
QSlider::groove:vertical {
  width: 20;
  min-width: 20;
}
QSlider::handle:horizontal {
  margin-left: -1px;
  margin-right: -1px;
  width: 10px;
  image: url('../Default/imgs/white/slider/slider-handle-rectangle.svg');
}
QSlider::handle:horizontal:disabled {
  image: url('../Default/imgs/white/slider/slider-handle-rectangle_disabled.svg');
}
QSlider::handle:vertical {
  margin-top: -1px;
  margin-bottom: -1px;
  height: 10px;
  image: url('../Default/imgs/white/slider/slider-handle-v-rectangle.svg');
}
QSlider::handle:vertical:disabled {
  image: url('../Default/imgs/white/slider/slider-handle-v-rectangle_disabled.svg');
}
/* -----------------------------------------------------------------------------
   Double Sliders
----------------------------------------------------------------------------- */
#IntPairField,
#DoublePairField {
  qproperty-LightLineColor: #24262a;
  qproperty-LightLineEdgeColor: #24262a;
  qproperty-DarkLineColor: #24262a;
  qproperty-MiddleLineColor: #24262a;
  qproperty-HandleLeftPixmap: url("../Default/imgs/white/slider/slider-handle-rectangle.svg");
  qproperty-HandleRightPixmap: url("../Default/imgs/white/slider/slider-handle-rectangle.svg");
  qproperty-HandleLeftGrayPixmap: url("../Default/imgs/white/slider/slider-handle-rectangle_disabled.svg");
  qproperty-HandleRightGrayPixmap: url("../Default/imgs/white/slider/slider-handle-rectangle_disabled.svg");
}
/* -----------------------------------------------------------------------------
   Labels
----------------------------------------------------------------------------- */
QLabel {
  background-color: transparent;
  color: #d6d9dc;
}
QLabel:disabled {
  color: rgba(214, 217, 220, 0.4);
}
/* -----------------------------------------------------------------------------
   Tool Buttons
----------------------------------------------------------------------------- */
QToolButton {
  background-color: transparent;
  border: 1 solid transparent;
  border-radius: 3px;
  color: #d6d9dc;
  padding-top: -1;
  padding-right: -1;
  padding-bottom: -2;
  padding-left: 0;
  margin-left: 1;
  margin-right: 1;
}
QToolButton:hover {
  background-color: #4f5359;
  border-color: #4f5359;
  color: #d6d9dc;
}
QToolButton:pressed {
  background-color: #2d2f32;
  border-color: #2d2f32;
  color: white;
}
QToolButton:checked {
  background-color: #3296a8;
  border-color: #3296a8;
  color: white;
}
QToolButton:checked:hover {
  background-color: #3ba6b8;
  border-color: #3ba6b8;
}
QToolButton:checked:pressed {
  background-color: #277685;
}
QToolButton:disabled {
  color: rgba(214, 217, 220, 0.4);
  background-color: transparent;
}
QToolButton:disabled:checked {
  background-color: #37616b;
  border-color: #37616b;
}
QToolButton::menu-indicator {
  image: none;
}
QToolButton::menu-button {
  border-image: none;
}
/* -----------------------------------------------------------------------------
   QToolBar (and misc Toolbars)
----------------------------------------------------------------------------- */
QToolBar {
  padding: 0;
  icon-size: 20px;
  qproperty-iconSize: 20px;
}
QToolBar::separator:horizontal {
  border-left: 1 solid #4a4e54;
  margin: 0 1;
  width: 0;
}
QToolBar::separator:vertical {
  border-top: 1 solid #4a4e54;
  height: 0;
  margin: 1 0;
}
QToolBar QLabel {
  margin-top: 1;
}
QToolBar QToolBar {
  border: 0;
}
QToolBarExtension {
  margin: 0;
  padding: 0;
  qproperty-icon: none;
  background-image: url('../Default/imgs/white/misc/toolbar_extension_horizontal.png');
  background-repeat: no-repeat;
  background-position: center center;
}
#ScrollLeftButton,
#ScrollRightButton,
#ScrollUpButton,
#ScrollDownButton {
  background-color: #4d5157;
  border-width: 1;
  border-style: solid;
  border-color: #5c6066;
  border-radius: 0;
  padding: 0;
  margin: 0;
  width: 20;
  max-width: 20;
  height: 20;
  max-height: 20;
  min-width: 20;
}
#ScrollLeftButton:hover,
#ScrollRightButton:hover,
#ScrollUpButton:hover,
#ScrollDownButton:hover {
  background-color: #585d63;
  border-color: #5c6066;
}
#ScrollLeftButton:pressed,
#ScrollRightButton:pressed,
#ScrollUpButton:pressed,
#ScrollDownButton:pressed {
  background-color: #33363a;
  border-color: #5c6066;
}
#ScrollLeftButton:disabled,
#ScrollRightButton:disabled,
#ScrollUpButton:disabled,
#ScrollDownButton:disabled {
  background-color: #46494f;
  border-color: #5c6066;
  color: rgba(214, 217, 220, 0.4);
}
#ScrollLeftButton {
  image: url('../Default/imgs/white/scrollbar/scroll-left.svg');
  margin-top: -1;
  margin-bottom: -1;
  margin-left: -1;
}
#ScrollLeftButton:hover {
  image: url('../Default/imgs/white/scrollbar/scroll-left-hover.svg');
}
#ScrollRightButton {
  image: url('../Default/imgs/white/scrollbar/scroll-right.svg');
  margin-top: -1;
  margin-bottom: -1;
  margin-right: -1;
}
#ScrollRightButton:hover {
  image: url('../Default/imgs/white/scrollbar/scroll-right-hover.svg');
}
#ScrollUpButton {
  image: url('../Default/imgs/white/scrollbar/scroll-up.svg');
}
#ScrollUpButton:hover {
  image: url('../Default/imgs/white/scrollbar/scroll-up-hover.svg');
}
#ScrollDownButton {
  image: url('../Default/imgs/white/scrollbar/scroll-down.svg');
}
#ScrollDownButton:hover {
  image: url('../Default/imgs/white/scrollbar/scroll-down-hover.svg');
}
/* -----------------------------------------------------------------------------
   Frame Navigator Widget
----------------------------------------------------------------------------- */
QToolBar#WidePaddingToolBar {
  margin: 0;
  padding: 0;
}
QToolBar#WidePaddingToolBar QToolButton {
  padding-left: 2;
  padding-right: 1;
  min-width: 30;
  min-height: 20;
}
/* -----------------------------------------------------------------------------
   Treeviews
----------------------------------------------------------------------------- */
QTreeWidget {
  font-weight: normal;
  background-color: #2f3236;
  alternate-background-color: rgba(255, 255, 255, 0.03);
  border: 0;
  margin: 0;
  outline: 0;
}
QTreeWidget::item:selected {
  background-color: #3296a8;
  color: white;
}
QTreeWidget::item:selected:hover {
  background-color: #41b2c7;
  color: white;
}
QTreeWidget::item:hover {
  background-color: #44494f;
}
QTreeWidget::branch {
  background-color: transparent;
}
QTreeWidget::branch:adjoins-item {
  border-image: url('../Default/imgs/white/misc/transparent_16x16.png');
}
QTreeWidget::branch:has-siblings {
  border-image: url('../Default/imgs/white/misc/transparent_16x16.png');
}
QTreeWidget::branch:has-siblings:adjoins-item {
  border-image: url('../Default/imgs/white/misc/transparent_16x16.png');
}
QTreeWidget::branch:has-children:closed {
  background: url('../Default/imgs/white/tree/treebranch-closed.svg') no-repeat;
  background-position: center center;
  border-image: none;
  image: none;
}
QTreeWidget::branch:has-children:open {
  background: url('../Default/imgs/white/tree/treebranch-open.svg') no-repeat;
  background-position: center center;
  image: none;
}
QTreeWidget::branch:has-children:has-siblings:closed {
  background: url('../Default/imgs/white/tree/treebranch-closed.svg') no-repeat;
  background-position: center center;
  border-image: none;
  image: none;
}
QTreeWidget::branch:has-children:has-siblings:open {
  background: url('../Default/imgs/white/tree/treebranch-open.svg') no-repeat;
  background-position: center center;
  border-image: none;
  image: none;
}
QTreeView {
  font-weight: normal;
  background-color: #2f3236;
  alternate-background-color: rgba(255, 255, 255, 0.03);
  border: 0;
  margin: 0;
  outline: 0;
}
QTreeView::item:selected {
  background-color: #3296a8;
  color: white;
}
QTreeView::item:selected:hover {
  background-color: #41b2c7;
  color: white;
}
QTreeView::item:hover {
  background-color: #44494f;
}
QTreeView::branch {
  background-color: transparent;
}
QTreeView::branch:adjoins-item {
  border-image: url('../Default/imgs/white/misc/transparent_16x16.png');
}
QTreeView::branch:has-siblings {
  border-image: url('../Default/imgs/white/misc/transparent_16x16.png');
}
QTreeView::branch:has-siblings:adjoins-item {
  border-image: url('../Default/imgs/white/misc/transparent_16x16.png');
}
QTreeView::branch:has-children:closed {
  background: url('../Default/imgs/white/tree/treebranch-closed.svg') no-repeat;
  background-position: center center;
  border-image: none;
  image: none;
}
QTreeView::branch:has-children:open {
  background: url('../Default/imgs/white/tree/treebranch-open.svg') no-repeat;
  background-position: center center;
  image: none;
}
QTreeView::branch:has-children:has-siblings:closed {
  background: url('../Default/imgs/white/tree/treebranch-closed.svg') no-repeat;
  background-position: center center;
  border-image: none;
  image: none;
}
QTreeView::branch:has-children:has-siblings:open {
  background: url('../Default/imgs/white/tree/treebranch-open.svg') no-repeat;
  background-position: center center;
  border-image: none;
  image: none;
}
QListView {
  outline: 0;
  background-color: #2f3236;
  alternate-background-color: rgba(255, 255, 255, 0.03);
}
/* -----------------------------------------------------------------------------
   Treeview Column Headers
----------------------------------------------------------------------------- */
QHeaderView::section {
  background-color: #45484d;
  border: 1 solid #24262a;
  padding-left: 4;
  margin-left: -1;
  margin-top: -1;
}
/* -----------------------------------------------------------------------------
   Tabs
----------------------------------------------------------------------------- */
QTabWidget::pane {
  background-color: transparent;
  top: -1;
  border: 1 solid #4a4e54;
}
QTabBar {
  background-color: transparent;
}
QTabBar::tab {
  background-color: #2d2f32;
  border: 1 solid #4a4e54;
  color: #9aa0a6;
  margin-top: 4;
  margin-right: -1;
  margin-bottom: 0;
  margin-left: 0;
  padding: 2 7 1 7;
}
QTabBar::tab:hover {
  background-color: #35383c;
  color: #ffffff;
}
QTabBar::tab:selected {
  background-color: #3b3e42;
  border-top-right-radius: 2;
  border-top-left-radius: 2;
  border-bottom-color: #3b3e42;
  color: #ffffff;
  margin-top: 1;
  margin-right: -1;
  margin-bottom: -2;
  margin-left: 0;
  padding: 2 7 2 7;
}
QTabBar::tab:only-one {
  margin: 1 0 0 0;
  padding: 3 7 3 7;
}
QTabBar::tab:first {
  border-top-left-radius: 2;
}
QTabBar::tab:last {
  margin-right: 0;
  border-top-right-radius: 2;
}
QTabBar QToolButton {
  background-color: #4d5157;
  border-width: 1;
  border-style: solid;
  border-color: #5c6066;
  border-radius: 0;
  padding: 0;
  margin: 0;
  width: 16;
  max-width: 16;
  height: 20;
  max-height: 20;
  margin-top: -1;
  padding: 4 2 2 2;
}
QTabBar QToolButton:hover {
  background-color: #585d63;
  border-color: #5c6066;
}
QTabBar QToolButton:pressed {
  background-color: #33363a;
  border-color: #5c6066;
}
QTabBar QToolButton:disabled {
  background-color: #46494f;
  border-color: #5c6066;
  color: rgba(214, 217, 220, 0.4);
}
#TabBarContainer {
  background-color: #2d2f32;
  qproperty-BottomBelowLineColor: #24262a;
}
#TabBarContainer QTabBar::tab {
  background-color: #2d2f32;
  border: 1 solid #24262a;
  border-top-width: 0;
  border-left-width: 0;
  border-radius: 0;
  color: #9aa0a6;
  padding: 3 4;
  margin: 0;
}
#TabBarContainer QTabBar::tab:hover {
  background-color: #35383c;
  color: #ffffff;
}
#TabBarContainer QTabBar::tab:selected {
  background-color: #3b3e42;
  color: #ffffff;
  border-color: #24262a;
  border-top-color: transparent;
  border-bottom-color: #3b3e42;
  background-image: url("../Default/imgs/white/misc/tab-accent-toonboom.svg");
  background-repeat: repeat-x;
  background-position: top left;
}
