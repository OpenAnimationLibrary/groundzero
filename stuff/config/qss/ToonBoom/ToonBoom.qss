}
#DirTreeView::branch:has-children:has-siblings:open {
  background: url('../Default/imgs/white/tree/treebranch-open.svg') no-repeat;
  background-position: center center;
  border-image: none;
  image: none;
}
#FileBrowser {
  background-color: #3b3e42;
}
#FileBrowser #buttonBar {
  background-color: #3b3e42;
}
#FileBrowser #buttonBar QToolButton {
  background-color: transparent;
  border: 1 solid transparent;
  border-radius: 3px;
  color: #d6d9dc;
  padding-top: 1;
  padding-right: 1;
  padding-bottom: 0;
  padding-left: 2;
}
#FileBrowser #buttonBar QToolButton:hover {
  background-color: #4f5359;
  border-color: #4f5359;
  color: #d6d9dc;
}
#FileBrowser #buttonBar QToolButton:pressed {
  background-color: #2d2f32;
  border-color: #2d2f32;
  color: white;
}
#FileBrowser #buttonBar QToolButton:checked {
  background-color: #3296a8;
  border-color: #3296a8;
