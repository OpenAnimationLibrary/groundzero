<fxlayout help_file="DotScreen.html">
  <page name="Dot Screen">
    <control>spacing</control>
    <control>angle</control>
    <control>stagger</control>
    <control>jitter</control>
    <separator label="Dot"/>
    <control>shape</control>
    <control>size</control>
    <control>aspect</control>
    <control>rotation</control>
    <control>opacity</control>
    <control>softness</control>
    <separator label="Colour"/>
    <control>color</control>
    <control>color2</control>
    <control>colorRandom</control>
    <separator label="Randomness"/>
    <control>sizeRandom</control>
    <control>aspectRandom</control>
    <control>rotationRandom</control>
    <control>opacityRandom</control>
    <control>hold</control>
    <control>seed</control>
  </page>
  <page name="Modifiers">
    <separator label="Modifier 1 (Source)"/>
    <control>source1</control>
    <vbox modeSensitive="source1" mode="1,2">
      <control>rampStart1</control>
      <control>rampEnd1</control>
    </vbox>
    <control>target1</control>
    <control>mode1</control>
    <control>low1</control>
    <control>high1</control>
    <control>invert1</control>
    <separator label="Modifier 2 (Control2)"/>
    <control>source2</control>
    <vbox modeSensitive="source2" mode="1,2">
      <control>rampStart2</control>
      <control>rampEnd2</control>
    </vbox>
    <control>target2</control>
    <control>mode2</control>
    <control>low2</control>
    <control>high2</control>
    <control>invert2</control>
    <separator label="Modifier 3 (Control3)"/>
    <control>source3</control>
    <vbox modeSensitive="source3" mode="1,2">
      <control>rampStart3</control>
      <control>rampEnd3</control>
    </vbox>
    <control>target3</control>
    <control>mode3</control>
    <control>low3</control>
    <control>high3</control>
    <control>invert3</control>
  </page>
</fxlayout>
